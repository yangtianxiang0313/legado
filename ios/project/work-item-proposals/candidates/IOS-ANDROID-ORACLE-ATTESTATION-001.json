        {
          "id": "AC-4",
          "statement": "trusted importer 对 proposal 与 evidence archive 分别调用 gh attestation verify，固定 repository、signer workflow、当前 HEAD source digest、SLSA provenance 和 deny-self-hosted-runners；再安全解包、核对 evidence bundle SHA/URI/run identity、payload bytes/digest、proposal contract 和双 archive 内容清单。验证成功只输出 candidate_only review report，不写 Golden、Requirement、Approval、state 或 event。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-5",
          "statement": "测试覆盖两阶段打包确定性、attestation 循环依赖规避、命令面无 promote/publish、gh 参数策略、伪造 repo/workflow/source/self-hosted、bundle/hash、archive traversal/symlink/duplicate、payload/proposal 篡改和 importer 无仓内写入；README、Capability、Checkpoint、Pitfall 说明人工 Publisher 仍是唯一 Golden authority。",
          "verified_by": [
