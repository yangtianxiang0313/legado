        {
          "id": "AC-3",
          "statement": "打包器从 local_run 的结构化 artifact 生成 canonical-v1 Android payload 和确定性 evidence archive；evidence attestation 产生后才生成 proposal，proposal 精确引用 evidence attestation URL 与 raw bundle SHA-256，随后通过现有 verify-proposal 并形成第二个确定性 proposal archive。任意输入漂移、非 canonical JSON、archive 重复路径、symlink、绝对/上跳路径或 digest 不一致均失败。",
          "verified_by": [
            "harness-tests",
            "fixture-contract"
          ],
          "requirement_clauses": [
