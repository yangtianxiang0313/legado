  "api_version": "legado.harness/v1",
  "kind": "WorkItem",
  "metadata": {
    "id": "IOS-ANDROID-ORACLE-ATTESTATION-001",
    "title": "建立 GitHub-hosted Android Oracle 双证明提案链",
    "priority": 100,
    "risk": "high",
    "labels": [
      "phase-1",
      "conformance",
      "android-oracle",
      "oracle-golden-request",
      "source-lab",
