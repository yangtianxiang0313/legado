{
  "schema_version": 1,
  "proposal_id": "IOS-GITHUB-ORACLE-DISPATCHER-HARDENING-001",
  "proposal_constraint": "只强化既有 GitHub Oracle Dispatcher 与 Supervisor 外部执行路径；create-only branch push 必须成为唯一服务端创建动作，禁止继续调用 workflow_dispatch，禁止下载/信任 artifact、生成 receipt、发布 Golden 或修改 Workflow/Oracle/产品",
  "work_item": {
    "api_version": "legado.harness/v1",
    "kind": "WorkItem",
    "metadata": {
      "id": "IOS-GITHUB-ORACLE-DISPATCHER-HARDENING-001",
      "title": "以 branch push/run 对账闭合 GitHub Oracle 幂等恢复",
      "priority": 100,
      "risk": "high",
      "labels": [
        "phase-0",
        "control-plane",
        "loop-supervisor",
        "external-execution",
        "github-actions",
        "android-oracle",
        "idempotency",
        "recovery",
        "corrective"
      ]
    },
    "spec": {
      "capability": "CAP-KNOWLEDGE-CONTROL",
      "intent": "在 IOS-GITHUB-ORACLE-PUSH-TRIGGER-RECOVERY-002 已使固定 Workflow 支持 deterministic branch push 后，消除 PIT-0061 剩余的 workflow_dispatch 发送歧义。GitHubOracleDispatcher 不再调用 gh workflow run；远端 feature/oracle-<scenario>-<source-sha> branch 的首次 create-only push 是唯一服务端创建动作，既有同 SHA branch 只复用，冲突拒绝。adapter 查询固定 workflow、branch 与 event=push 的唯一 run：本次创建 branch 且 run 尚未可见返回 dispatched，既有 branch 且 run 尚未可见返回 pending，一个精确绑定 run 映射 queued/in_progress/completed，多个或任何绑定漂移 fail closed。崩溃发生在 push 返回前后均可通过远端 branch/run 恢复，不会产生第二次 push 或第二种触发。强化 journal 的 identity、run id/attempt/status/terminal 单调性以及 response schema；补齐 clean HEAD、remote、auth、branch、零/一/多 run、状态、journal 和 Supervisor 不调用 Agent 的隔离测试。CAP-KNOWLEDGE-CONTROL revision 60→61。本项不修改 Workflow、Oracle producer/importer、receipt、Publisher、Golden、SourceLab、产品或 Package。",
      "depends_on": [
        "IOS-GITHUB-ORACLE-DISPATCHER-001",
        "IOS-GITHUB-ORACLE-PUSH-TRIGGER-RECOVERY-002"
      ],
