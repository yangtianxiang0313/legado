    {
      "quality_attribute": "determinism",
      "scenario": "错误 charset 和损坏 ZIP 也必须产生稳定、可结构化比较的结果，不能依赖系统 locale 或隐式 Foundation 默认编码。",
      "criticality": "high"
    },
    {
      "quality_attribute": "testability",
      "scenario": "解码器与重定向策略必须可由注入的响应字节、header、最终 URL 和失败类型驱动，不依赖真实公网。",
      "criticality": "critical"
    },
    {
      "quality_attribute": "evolvability",
      "scenario": "解码结果需要同时保留正文与最终 URL，供后续 baseUrl 和相对链接求值复用，不把 URL 解析耦合进解码算法。",
      "criticality": "high"
    }
  ],
  "decision_questions": [
