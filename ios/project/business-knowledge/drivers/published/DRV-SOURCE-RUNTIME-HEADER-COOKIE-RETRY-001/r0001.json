      "criticality": "critical"
    },
    {
      "quality_attribute": "security",
      "scenario": "CookieJar 等内部控制标记只能存在于 Transport 适配边界，必须在网络发送前移除。",
      "criticality": "critical"
    },
    {
      "quality_attribute": "observability",
      "scenario": "验收必须同时输出构造 Header、解析后 Header、wire Header、retry 值与按路由请求次数。",
      "criticality": "high"
    },
    {
      "quality_attribute": "evolvability",
      "scenario": "非法 retry、异常重试、POST 重放和重定向应由后续 Android characterization 独立扩展，当前实现不得猜测。",
      "criticality": "high"
    }
  ],
  "decision_questions": [
