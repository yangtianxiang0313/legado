      "id": "BKC-INTEGRATION-ARCHIVE-CODEC-001",
      "revision": 1,
      "semantic_key": "integration.dependencies.archive-codec",
      "kind": "business_inference",
      "topic": "归档、加密与迁移依赖候选",
