      "app/src/main/java/io/legado/app/ui/book/read/page/entities/TextChapter.kt#getReadLength",
      "app/src/main/java/io/legado/app/ui/book/read/page/entities/TextChapter.kt#getPageIndexByCharIndex",
      "app/src/main/java/io/legado/app/ui/book/read/ReadBookActivity.kt#onPause"
    ],
