          "branch_refs": [
            "the in-memory chapter index is clamped to chapterSize - 1",
            "the passed Book retains its oversized persisted index until a later save"
          ]
        },
        {
          "id": "empty-toc-clamps-index-to-zero",
          "role": "boundary",
          "android_fact_refs": [
            "AF-READ-BOOK-RESET-DATA"
          ],
          "branch_refs": [
            "chapterSize - 1 is negative for an empty TOC",
            "coerceAtLeast(0) still produces runtime chapter index zero"
          ]
        },
        {
          "id": "local-book-clears-stale-remote-source",
          "role": "nominal",
          "android_fact_refs": [
            "AF-READ-BOOK-RESET-DATA"
          ],
          "branch_refs": [
            "local books set isLocalBook and force bookSource to null",
