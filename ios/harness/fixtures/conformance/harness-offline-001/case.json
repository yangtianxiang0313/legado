{
  "schema_version": 1,
  "id": "harness-offline-001",
  "operation": "search",
  "capabilities": ["CAP-RUNTIME-PORTS", "CAP-CONFORMANCE"],
  "compatibility_profile": "android-legado-v1",
  "source": "source.json",
  "input": "input.json",
  "transport": {
    "mode": "offline",
    "responses": [
      {
        "id": "search-response",
        "match": {
          "method": "GET",
          "url": "https://fixture.test/search?q=%E6%98%9F%E6%B2%B3"
        },
        "respond": {
          "status": 200,
          "effective_url": "https://fixture.test/search?q=%E6%98%9F%E6%B2%B3",
          "headers": [
            {"name": "content-type", "value": "application/json; charset=utf-8"}
          ],
          "body_file": "responses/search.json"
        }
      }
    ]
  },
  "determinism": {
    "clock": "2026-01-01T00:00:00Z",
    "timezone": "UTC",
    "locale": "en_US_POSIX",
    "random_seed": 7,
    "network_allowed": false
  },
  "limits": {
    "timeout_ms": 1000,
    "max_response_bytes": 65536,
    "max_request_body_bytes": 4096,
    "max_requests": 4
  }
}
