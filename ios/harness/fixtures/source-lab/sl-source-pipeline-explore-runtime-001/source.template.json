{
  "bookSourceUrl": "${SOURCE_LAB_ORIGIN}",
  "bookSourceName": "SourceLab 发现流水线源",
  "bookSourceGroup": "SourceLab",
  "bookSourceType": 0,
  "customOrder": 41,
  "enabled": true,
  "enabledExplore": true,
  "exploreUrl": "奇幻::${SOURCE_LAB_ORIGIN}/pipeline/explore/{{page}}?category=fantasy",
  "searchUrl": "${SOURCE_LAB_ORIGIN}/unused-search?q={{key}}",
  "ruleSearch": {
    "bookList": "@CSS:.wrong-search-item",
    "name": "@CSS:.wrong-name@text",
    "author": "@CSS:.wrong-author@text",
    "bookUrl": "@CSS:a@href"
  },
  "ruleExplore": {
    "bookList": "-@CSS:.explore-item",
    "name": "@CSS:.book-name@text",
    "author": "@CSS:.book-author@text",
    "intro": "@CSS:.book-intro@text",
    "kind": "@CSS:.book-kind@text",
    "wordCount": "@CSS:.book-word-count@text",
    "lastChapter": "@CSS:.book-last-chapter@text",
    "bookUrl": "@CSS:a.book-link@href",
    "coverUrl": "@CSS:img.book-cover@src"
  },
  "ruleBookInfo": {
    "name": "@CSS:h1.book-name@text",
    "author": "@CSS:.book-author@text",
    "intro": "@CSS:.book-intro@text",
    "kind": "@CSS:.book-kind@text",
    "lastChapter": "@CSS:.book-last-chapter@text",
    "coverUrl": "@CSS:img.book-cover@src",
    "tocUrl": "@CSS:a.toc-link@href"
  },
  "ruleToc": {
    "chapterList": "@CSS:.chapter",
    "chapterName": "@CSS:a@text",
    "chapterUrl": "@CSS:a@href"
  },
  "ruleContent": {
    "content": "@CSS:#content@html"
  },
  "x-source-lab": {
    "scenario": "sl-source-pipeline-explore-runtime-001",
    "logicalOrigin": "http://sourcelab.test"
  }
