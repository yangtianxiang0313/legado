{
  "bookSourceUrl": "${SOURCE_LAB_ORIGIN}",
  "bookSourceName": "SourceLab POST Form 测试源",
  "bookSourceGroup": "SourceLab",
  "bookSourceType": 0,
  "enabled": true,
  "enabledExplore": false,
  "searchUrl": "${SOURCE_LAB_ORIGIN}/post/{{key}},{\"method\":\"POST\",\"body\":\"{{key == 'nominal' ? 'keyword=星河&author=北辰' : 'empty=&dup=first&dup=second&encoded=%E6%98%9F%E6%B2%B3'}}\"}",
  "ruleSearch": {
    "bookList": "@CSS:.book-item",
    "name": "@CSS:.book-name@text",
    "author": "@CSS:.book-author@text",
    "bookUrl": "@CSS:a.book-link@href"
  },
  "ruleBookInfo": {
    "name": "@CSS:h1.book-name@text",
    "author": "@CSS:.book-author@text",
    "tocUrl": "@CSS:a.toc-link@href"
  },
  "ruleToc": {
    "chapterList": "@CSS:#chapter-list > li.chapter",
    "chapterName": "@CSS:a@text",
    "chapterUrl": "@CSS:a@href"
  },
  "ruleContent": {
    "title": "@CSS:h1.chapter-title@text",
    "content": "@CSS:#chapter-content@html"
  },
  "x-source-lab": {
    "scenario": "sl-post-form-001",
    "logicalOrigin": "http://sourcelab.test"
  }
}
