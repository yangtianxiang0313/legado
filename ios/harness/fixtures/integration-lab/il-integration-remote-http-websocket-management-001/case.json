{
  "schema_version": 1,
  "kind": "integration_lab_scenario",
  "id": "il-integration-remote-http-websocket-management-001",
  "revision": 1,
  "status": "candidate",
  "operation": "remote_management_protocol",
  "capabilities": [
    "CAP-INTEGRATION-REMOTE-SERVICE",
    "CAP-CONFORMANCE"
  ],
  "compatibility_profile": "android-legado-v1",
  "input": "input.json",
  "transport": {
    "mode": "android_loopback_listener",
    "external_network": "deny",
    "client": "android_instrumentation_loopback"
  },
  "coverage": [
    {
      "behavior": "remote.listener-binding",
      "cases": [
        {
          "id": "listener-contract",
          "role": "nominal",
          "android_fact_refs": [
            "AF-REMOTE-HTTP-SERVE",
            "AF-REMOTE-WEBSOCKET-OPEN"
          ],
          "branch_refs": [
            "HttpServer and WebSocketServer inherit NanoHTTPD constructors with a port-only binding"
          ]
        }
      ]
    },
    {
      "behavior": "remote.http-cors",
      "cases": [
        {
          "id": "options-origin-echo",
          "role": "nominal",
          "android_fact_refs": ["AF-REMOTE-HTTP-SERVE"],
          "branch_refs": [
            "HttpServer OPTIONS returns CORS method/header fields and echoes the request Origin"
          ]
        },
        {
          "id": "options-without-origin",
          "role": "boundary",
          "android_fact_refs": ["AF-REMOTE-HTTP-SERVE"],
          "branch_refs": [
            "HttpServer OPTIONS passes a missing Origin through the response-header path"
          ]
        }
      ]
    },
    {
      "behavior": "remote.http-routing",
      "cases": [
        {
          "id": "static-index",
          "role": "nominal",
          "android_fact_refs": ["AF-REMOTE-HTTP-SERVE"],
          "branch_refs": [
            "Unknown GET controller routes fall through to bundled web assets"
          ]
        },
        {
          "id": "seeded-bookshelf",
          "role": "nominal",
          "android_fact_refs": ["AF-REMOTE-HTTP-SERVE"],
          "branch_refs": [
            "GET /getBookshelf maps to BookController and returns a JSON ReturnData envelope"
          ]
        },
        {
          "id": "missing-static-asset",
          "role": "boundary",
          "android_fact_refs": ["AF-REMOTE-HTTP-SERVE"],
          "branch_refs": [
            "Asset lookup failures are caught by HttpServer and converted to a fixed response"
          ]
        }
      ]
    },
    {
      "behavior": "remote.websocket-routing",
      "cases": [
        {
          "id": "book-source-debug-handshake",
          "role": "nominal",
          "android_fact_refs": ["AF-REMOTE-WEBSOCKET-OPEN"],
          "branch_refs": [
            "WebSocketServer accepts /bookSourceDebug"
          ]
        },
        {
          "id": "rss-source-debug-handshake",
          "role": "nominal",
          "android_fact_refs": ["AF-REMOTE-WEBSOCKET-OPEN"],
          "branch_refs": [
            "WebSocketServer accepts /rssSourceDebug"
          ]
        },
        {
          "id": "search-book-handshake",
          "role": "nominal",
          "android_fact_refs": ["AF-REMOTE-WEBSOCKET-OPEN"],
          "branch_refs": [
            "WebSocketServer accepts /searchBook"
          ]
        },
        {
          "id": "unknown-websocket-path",
          "role": "denied",
          "android_fact_refs": ["AF-REMOTE-WEBSOCKET-OPEN"],
          "branch_refs": [
            "WebSocketServer returns no WebSocket implementation for undeclared paths"
          ]
        }
      ]
    }
  ],
  "determinism": {
    "clock": "1970-01-01T00:00:00Z",
    "timezone": "UTC",
    "locale": "en_US_POSIX",
    "random_seed": 0,
    "network_allowed": false,
    "logical_origin": "http://integrationlab.test"
  },
  "limits": {
    "timeout_ms": 5000,
    "max_response_bytes": 1048576,
    "max_request_body_bytes": 1048576,
    "max_requests": 32,
    "max_concurrency": 2
  },
  "provenance": {
    "kind": "synthetic",
    "source_refs": [
      "app/src/main/java/io/legado/app/web/HttpServer.kt",
      "app/src/main/java/io/legado/app/web/WebSocketServer.kt",
      "app/src/main/java/io/legado/app/service/WebService.kt",
      "app/build.gradle"
    ],
    "introduced_by": "IOS-CHARACTERIZE-INTEGRATION-REMOTE-HTTP-WEBSOCKET-MANAGEMENT-001"
  }
}
