        "ios/project/business-knowledge/**",
        "ios/project/requirements/**",
        "ios/project/baseline.json",
        "ios/project/approvals/**",
        "ios/docs/**"
      ],
      "max_files_changed": 5,
      "max_changed_lines": 650
    },
    "inputs": {
      "context_files": [
        "ios/docs/ai-harness.md",
        "ios/docs/trusted-supervisor.md",
        "ios/docs/project-memory.md",
        "ios/docs/adr/0004-harness-memory-transaction.md",
        "ios/project/pitfalls/PIT-0010.json"
      ],
      "android_source_anchors": [],
      "fixtures": []
    },
    "architecture_refs": ["ARCH-014", "ADR-0004"],
    "acceptance": {
      "criteria": [
        {
          "id": "AC-1",
          "statement": "terminate_process_group 对进程已退出、SIGTERM/SIGKILL PermissionError 和清理期间竞态均不抛出未捕获异常，并把非空清理诊断返回给调用方。",
          "verified_by": ["harness-tests"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-2",
          "statement": "run_check 超时后在有界时间内返回 passed=false、timed_out=true，并准确记录 process_leak 与 cleanup_error；不得因第二次 communicate 或权限错误无限等待。",
          "verified_by": ["harness-tests"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-3",
          "statement": "verify 遇到清理 PermissionError 时仍生成 failed Evidence、VerificationFailed 事件和 failure fingerprint，不输出 Python traceback，不绕过 verify cycle。",
          "verified_by": ["harness-tests", "memory-close"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-4",
          "statement": "正常检查、普通超时、子进程在 timeout 与 cleanup 之间退出以及正常退出后遗留子进程的既有语义均有回归测试。",
          "verified_by": ["harness-tests"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-5",
          "statement": "修复不扩大任何 check timeout，不修改 schema、验收命令、golden、normalizer、三方依赖或产品代码；清理不确定时保持 fail-closed。",
          "verified_by": ["dependency-policy", "harness-tests"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-6",
          "statement": "PIT-0010 增加本次真实复现 Evidence 与修复版本，Checkpoint 记录失败模式、验证证据和 Source Runtime 恢复步骤。",
          "verified_by": ["memory-close"],
          "requirement_clauses": [],
          "knowledge_claims": []
        }
      ],
      "required_checks": ["dependency-policy", "harness-tests"]
    },
