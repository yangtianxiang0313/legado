{
  "api_version": "legado.harness/v1",
  "kind": "WorkItem",
  "metadata": {
    "id": "IOS-HARNESS-TIMEOUT-CLEANUP-001",
    "title": "让 Harness 超时清理失败保留结构化 Evidence",
    "priority": 100,
    "risk": "high",
    "labels": ["phase-0", "harness", "control-plane", "timeout", "evidence", "pitfall-repair"]
  },
  "spec": {
    "capability": "CAP-KNOWLEDGE-CONTROL",
    "intent": "修复 macOS 上 check 超时后进程组清理抛出 PermissionError，导致 claim/verify 以 traceback 中断且没有 Evidence 的控制面缺口；超时、进程退出竞态和清理权限错误都必须在有界时间内归一化为 fail-closed 的结构化检查结果，保留 timed_out、process_leak 与 cleanup_error 审计信息，不扩大超时、不弱化验收、不修改 Evidence schema。",
    "depends_on": [
      "IOS-HARNESS-APPROVAL-UI-001"
    ],
    "scope": {
      "allow_write": [
        "ios/harness/harness.py",
        "ios/harness/tests/test_harness.py",
        "ios/project/capabilities/CAP-KNOWLEDGE-CONTROL.json",
        "ios/project/checkpoints/IOS-HARNESS-TIMEOUT-CLEANUP-001.json",
        "ios/project/pitfalls/PIT-0010.json"
      ],
      "deny_write": [
        "app/**",
        "modules/**",
        "ios/Packages/**",
        "ios/harness/config.json",
        "ios/harness/schemas/**",
        "ios/harness/work-items/**",
        "ios/harness/goldens/**",
        "ios/harness/normalization/**",
        "ios/harness/fixtures/**",
        "ios/harness/source-lab/**",
