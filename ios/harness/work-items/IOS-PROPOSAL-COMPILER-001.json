{
  "api_version": "legado.harness/v1",
  "kind": "WorkItem",
  "metadata": {
    "id": "IOS-PROPOSAL-COMPILER-001",
    "title": "建立 initialization DAG 到不可变候选的编译器",
    "priority": 100,
    "risk": "high",
    "labels": [
      "phase-0",
      "control-plane",
      "automation",
      "proposal-compiler",
      "recovery-lineage"
    ]
  },
  "spec": {
    "capability": "CAP-KNOWLEDGE-CONTROL",
    "intent": "把 proposal-only initialization DAG 转换为确定性、可审计但不自动物化的 Work Item candidate。编译器必须以 recipe 中人工设计的完整 Work Item 为语义来源，只负责验证 DAG 节点一致性、解析 completed/replacement/knowledge-output recovery 谱系、冻结输入摘要并原子写 candidate 与 provenance manifest；不得根据 Android package 或节点标题臆造 scope、AC、Gate、预算或知识合同，不得修改 Harness queue/state/event/status/work-items，不得提供 materialize/approve/publish/accept 旁路。本项同时为当前唯一可推进的 Integrations 节点建立 recipe，并证明生成 candidate 可通过 Loop Supervisor preflight。",
    "depends_on": [
      "IOS-KNOWLEDGE-DAG-REPAIR-001",
      "IOS-LOOP-SUPERVISOR-E2E-001"
    ],
    "scope": {
      "allow_write": [
        "ios/harness/proposal_compiler.py",
        "ios/harness/tests/test_proposal_compiler.py",
        "ios/harness/README.md",
        "ios/project/work-item-proposals/recipes/IOS-KNOWLEDGE-INTEGRATIONS-001.json",
        "ios/project/work-item-proposals/candidates/IOS-KNOWLEDGE-INTEGRATIONS-001.json",
        "ios/project/work-item-proposals/candidate-manifests/IOS-KNOWLEDGE-INTEGRATIONS-001.json",
        "ios/project/capabilities/CAP-KNOWLEDGE-CONTROL.json",
        "ios/project/checkpoints/IOS-PROPOSAL-COMPILER-001.json",
        "ios/project/pitfalls/PIT-*.json"
      ],
      "deny_write": [
        "app/**",
        "modules/**",
        "ios/Packages/**",
        "ios/harness/harness.py",
        "ios/harness/loop_supervisor.py",
        "ios/harness/approval_ui.py",
        "ios/harness/config.json",
        "ios/harness/architecture-rules.json",
        "ios/harness/dependency-policy.json",
        "ios/harness/schemas/**",
        "ios/harness/business-knowledge/**",
        "ios/harness/android-intake/**",
        "ios/harness/source-lab/**",
        "ios/harness/oracle/**",
        "ios/harness/goldens/**",
