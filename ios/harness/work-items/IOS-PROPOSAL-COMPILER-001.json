        "ios/project/work-item-proposals/initialization-dag.json",
        "ios/docs/**"
      ],
      "max_files_changed": 9,
      "max_changed_lines": 2600
    },
    "inputs": {
      "context_files": [
        "ios/project/work-item-proposals/initialization-dag.json",
        "ios/harness/loop_supervisor.py",
        "ios/harness/README.md",
        "ios/project/checkpoints/IOS-LOOP-SUPERVISOR-E2E-001.json",
        "ios/docs/trusted-supervisor.md"
      ],
      "android_source_anchors": [],
      "fixtures": []
    },
    "architecture_refs": [
      "ARCH-014",
      "ADR-0004"
    ],
    "acceptance": {
      "criteria": [
        {
          "id": "AC-1",
          "statement": "只读 plan 输出版本化确定性 JSON，逐节点区分 completed、ready_for_recipe、recipe_ready、materialized、dependency_blocked、gate_blocked 与 terminal_unresolved；同一输入重复执行字节一致，且不会写 candidate、manifest、queue、state、event、status 或 work-items。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-2",
          "statement": "依赖解析先接受直接 completed，再沿 state.replacement 有界解析；terminal 节点无 replacement 时，仅当存在唯一 completed Work Item 且其 knowledge.produces 覆盖原节点全部 kind/id 并使用更高 revision 时才视为 recovery。循环、缺失、歧义、部分覆盖和非递增 revision 均返回结构化 blocker。当前 UI Topology exhausted 节点必须解析到 IOS-KNOWLEDGE-UI-TOPOLOGY-RECOVERY-002，而不是被静默当成 completed。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-3",
          "statement": "recipe 必须包含完整 Work Item，编译器通过真实 Harness validator，并机械核对 proposal_id/title/depends_on、knowledge_mode、精确 produces kind/id/revision、Gate 与 DAG constraint；任何不一致均 fail closed，编译器不生成或补写 scope、AC、预算、Gate、Requirement、SourceLab 或 knowledge 字段。",
          "verified_by": [
            "harness-tests",
            "scope-policy"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-4",
          "statement": "compile 只允许选择 plan 中 recipe_ready 的单个 proposal；以 create-only 原子事务写 candidate 和 candidate-manifest，任一写入失败时两者均回滚。已存在且字节相同则幂等成功，任一文件漂移或目标成为 symlink 时拒绝覆盖，不提供 --force/--replace。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-5",
          "statement": "candidate-manifest 冻结 DAG digest、节点 fingerprint、recipe digest、candidate digest、原始与 resolved dependency、每个 completed dependency 的 Work Item/Evidence/Checkpoint digest，以及生成器版本。manifest 可独立重算；任何输入变化后旧 manifest 必须报告 stale，不能继续冒充当前候选。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-6",
          "statement": "为 IOS-KNOWLEDGE-INTEGRATIONS-001 提供完整 recipe，编译出的 candidate 通过 Loop Supervisor preflight，依赖冻结到已完成 Android Surfaces；输出仍是 proposal candidate，不自动 materialize、不运行 Agent、不发布 Packet/Driver、不接受 ADR。CLI help 不含 materialize、approve、publish、accept。",
          "verified_by": [
            "harness-tests",
            "dependency-policy"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-7",
          "statement": "README 描述 DAG proposal、recipe、candidate、manifest、按钮物化四层边界和推荐命令；Checkpoint 记录当前节点解析结果、Integrations 下一步、外部受信 Supervisor 与真实 Agent adapter 仍未完成的边界。",
          "verified_by": [
            "memory-close"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        }
      ],
      "required_checks": [
