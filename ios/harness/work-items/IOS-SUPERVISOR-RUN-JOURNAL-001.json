    "acceptance": {
      "criteria": [
        {
          "id": "AC-1",
          "statement": "运行日志使用受限的 .harness-runtime 子目录、0600 文件、原子替换、单调 sequence、previous hash 与 record hash；路径拒绝 symlink/非普通文件，记录有大小和数量上限。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-2",
          "statement": "日志只包含受控枚举、Work Item/attempt/phase、HEAD、控制绑定 digest、候选 snapshot digest 和时间；测试证明 prompt、context、stdout、stderr、环境变量和凭据不会写入。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-3",
          "statement": "只有成功完成记录且当前 Work Item、attempt、phase、HEAD、控制绑定与候选快照完全一致时，Supervisor 才结构化记录 replay 并跳过重复 Agent；verify/close 仍由 Harness 执行。缺失、旧 attempt、控制漂移、候选漂移和日志篡改均不授予跳过权限。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-4",
          "statement": "独立子进程故障注入证明：完成记录前终止会重新调用 Agent；implementation 完成记录后终止会直接 verify；memory_close 完成记录后终止会直接 close；截断或篡改日志不会静默跳过。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-5",
          "statement": "README、Checkpoint、PIT-0027 与 Capability 明确区分本地恢复提示、仓内业务状态/Evidence 和生产受信 journal，不把共享权限下的本地日志描述为安全 authority。",
          "verified_by": [
