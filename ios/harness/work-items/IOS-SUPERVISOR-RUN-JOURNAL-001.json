    "id": "IOS-SUPERVISOR-RUN-JOURNAL-001",
    "title": "为 Loop Supervisor 增加可重放运行日志",
    "priority": 100,
    "risk": "high",
    "labels": [
      "phase-0",
      "control-plane",
      "loop-engine",
