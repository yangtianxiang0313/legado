  "spec": {
    "capability": "CAP-KNOWLEDGE-CONTROL",
    "intent": "补齐 Loop Supervisor 的进程级中断恢复。新增 repo 内忽略版本控制、仅本机可读的内容寻址运行日志：在 implementation Agent 或 memory_close Agent 成功退出、候选快照与控制绑定确认后原子记录完成点；新 Supervisor 进程仅在 Work Item、attempt、phase、控制绑定、HEAD 与候选快照全部一致时跳过重复 Agent，继续由 Harness verify/close 裁决。日志不保存 prompt、context、stdout、stderr、环境变量或凭据，不成为业务状态、Evidence 或发布 authority；缺失、过期、截断、篡改和身份漂移均不得授予跳过权限。通过独立进程故障注入覆盖记录前崩溃、记录后崩溃、篡改、候选漂移和 memory_close 恢复。",
    "depends_on": [
      "IOS-CONTROL-CATALOG-RESUME-001"
    ],
    "scope": {
      "allow_write": [
        "ios/harness/run_journal.py",
        "ios/harness/loop_supervisor.py",
        "ios/harness/tests/test_run_journal.py",
