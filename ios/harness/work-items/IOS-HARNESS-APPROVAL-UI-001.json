    "acceptance": {
      "criteria": [
        {
          "id": "AC-1",
          "statement": "Harness 仅为已经进入 awaiting_human 且已冻结 review subject 的工作项打开本地验收页，页面明确展示工作项、Evidence、全部必需 Gate、review subject 摘要和文件清单。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-2",
          "statement": "批准只能由绑定 127.0.0.1 的页面通过 POST、严格 Host/Origin、一次性 CSRF token 和有限请求体触发；GET、缺失或错误 token、重放、跨 Origin、过期会话及 stale subject 均不得写 Approval。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-3",
          "statement": "一次人类点击为当前全部必需 Gate 原子化生成符合既有 schema 的 Approval，绑定精确 Work Item hash 与 review_subject_sha256，使用本地交互身份和带时区的短期有效期，随后由 Harness close；CLI 不提供 --yes、--reviewer、stdin token 或独立非交互 approve 命令。",
          "verified_by": [
            "harness-tests",
            "memory-close"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-4",
          "statement": "验收页禁用缓存、跨域和 iframe，使用限制型 CSP；会话在一次决策或超时后关闭，token 不写日志、不进入查询参数且不由 CLI 输出。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-5",
          "statement": "文档明确区分本地按钮的 cooperative guardrail 与生产可信审批：本地 signature 为 null、自报 OS 身份不能替代受保护 CI/SSO、user-presence 签名、独立 journal 和最终复验。",
          "verified_by": [
            "harness-tests",
            "memory-close"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-6",
          "statement": "实现只使用 Python 标准库，不新增、删除或升级任何三方依赖。",
          "verified_by": [
            "dependency-policy"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        }
