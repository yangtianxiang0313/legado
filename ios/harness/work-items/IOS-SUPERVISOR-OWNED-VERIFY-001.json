    "acceptance": {
      "criteria": [
        {
          "id": "AC-1",
          "statement": "显式 supervisor-owned-verification-v1 策略启用后，Agent 成功退出且状态仍为 implementing 时，Supervisor 在自身进程中调用 Harness.verify，并把 Evidence 路径、结果与失败分类作为结构化 transition 返回。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-2",
          "statement": "verify 失败且仍可重试时，下一轮复用同一 Work Item/Codex task 并带上最新 Evidence；rejected/exhausted/blocked/awaiting_human 等终态按 Harness 状态停止，不由 Supervisor 篡改。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-3",
          "statement": "verify 通过后，Supervisor 以 memory_close phase 再调用 Agent；Agent 只能写 Capability/Checkpoint/Pitfall 等 Work Item 已授权记忆文件，随后由 Supervisor 调用 close，close 失败必须结构化返回而不能伪装完成。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-4",
          "statement": "Codex adapter prompt 根据 context 中受绑定的 phase 明确禁止 Agent claim/verify/close：implementation 只改候选并可跑 targeted checks，memory_close 只做 passed Evidence 之后的记忆事务。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-5",
          "statement": "E2E 测试中的 fake Agent 不调用 Harness.verify/close，仍由 Supervisor 完成 materialize→claim→edit→verify→memory→close→queue_empty；同时保留旧配置行为并验证 secret/output/process-group 约束。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-6",
          "statement": "真实 Codex Loop 后续用该策略跑通 Integrations recovery；Checkpoint 与 PIT-0022 记录信任边界、失败证据和迁移结果，Capability 保持 partial。",
          "verified_by": [
            "memory-close"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        }
