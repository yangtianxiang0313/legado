  "metadata": {
    "id": "IOS-SUPERVISOR-OWNED-VERIFY-001",
    "title": "将受信 verify 与 close 移出 Agent 沙箱",
    "priority": 100,
    "risk": "high",
    "labels": [
      "phase-0",
      "control-plane",
