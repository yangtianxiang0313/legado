    "architecture_refs": [
      "ARCH-014",
      "ADR-0004"
    ],
    "acceptance": {
      "criteria": [
        {
          "id": "AC-1",
          "statement": "Harness 语义合同支持 gate_contract_version=1 和 decision_gates；现有 JSON Schema 的向后兼容扩展点保持不变。每个 decision 精确绑定 gate id、单一 question、why_human、2～4 个唯一 option（id/label/consequence/reversible）与唯一 recommended_option。重复 gate/option、空问题、推荐项不存在或普通 approval 文案均 fail closed；既有历史 v1 Work Item 仍可读取。",
          "verified_by": ["harness-tests"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-2",
          "statement": "Loop Supervisor preflight/materialize 对所有新 candidate 强制：gates 为空可全自动；gates 非空必须 gate_contract_version=1，且 gates 与 decision_gates 一一对应。旧 candidate 或新 candidate 不能用字符串 gate 获得批量批准入口。",
          "verified_by": ["harness-tests", "dependency-policy"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-3",
          "statement": "required_close_gates 只返回预先声明且由实际变化触发的结构化 human decision；required_checks/架构规则/安全策略继续自动执行。动态 product-scope、knowledge/architecture proposal、oracle difference 若缺匹配 decision contract，close 以 UNSTRUCTURED_DECISION_REQUIRED fail closed，不临时生成空泛 Gate。",
          "verified_by": ["harness-tests"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-4",
          "statement": "本地 UI 一次只展示一个未决 decision 的问题、why_human、选项后果、可逆性、推荐项和冻结 Evidence 摘要；页面不存在“批准全部”“approve all”或一次提交多个 gate 的操作。选择一个 option 后只原子写入该 decision，再重新冻结/展示下一项。",
          "verified_by": ["harness-tests"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-5",
          "statement": "Approval v1 decision record 绑定 work-item/tree/evidence、gate、decision_contract_sha256、selected_option、presented_at、decided_at、reviewer 和 TTL；错误/缺失 option、合同漂移、预先存在文件、重放、过期、跨 gate 提交或部分事务失败均拒绝，且不能推进 close。",
          "verified_by": ["harness-tests"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-6",
          "statement": "多 decision E2E 证明第一次点击后工作项仍 awaiting_human 且只产生一个绑定记录；第二个独立选择后才 completed。取消/延后不写 Approval、不丢失 Evidence，并返回结构化 human_decision_pending。",
          "verified_by": ["harness-tests"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-7",
          "statement": "没有 human decision 的普通高风险工作项在 required checks、scope、架构和记忆事务全部通过后自动 close，不因 risk 标签、security-review/architecture-review 习惯文案或文件数量暂停；测试证明 gates=[] 不打开审批 UI。",
          "verified_by": ["harness-tests"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-8",
          "statement": "本地 decision 只表达项目取舍，不具备 knowledge/golden/Requirement/ADR/patch promotion 权限；受保护 authority transition 仍必须验证独立签名 artifact，Harness/README 不把 local-user 点击描述为发布授权。",
          "verified_by": ["harness-tests", "memory-close"],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-9",
          "statement": "Harness README 明确三层模型：machine gate 自动、human decision 具体选择、authority transition 外部签名；记录此次“批准全部导致盲批”的 pitfall，并给出 future Work Item 编写示例和迁移规则。",
          "verified_by": ["memory-close"],
          "requirement_clauses": [],
          "knowledge_claims": []
        }
      ],
