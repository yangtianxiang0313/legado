{
  "api_version": "legado.harness/v1",
  "kind": "WorkItem",
  "metadata": {
    "id": "IOS-DECISION-GATE-POLICY-001",
    "title": "将盲批 Gate 替换为结构化决策暂停",
    "priority": 100,
    "risk": "high",
    "labels": [
      "phase-0",
      "control-plane",
      "automation",
      "human-decision",
      "gate-policy",
      "approval-ui",
      "anti-rubber-stamp"
    ]
  },
  "spec": {
    "capability": "CAP-KNOWLEDGE-CONTROL",
    "intent": "纠正本地 Harness 把人工 Gate 退化为“批准全部文件”的设计。保留 required_checks、scope、架构规则、安全策略等可机器证明的自动 Gate；只有 AI 无法从冻结事实推导、且确实需要项目所有者取舍的事项才创建 human decision。为新 Work Item 引入版本化 decision gate contract：每个 gate 必须给出单一具体问题、不可机器决定原因、2～4 个互斥选项、每项后果/可逆性和推荐项；Approval 必须绑定 decision contract hash 与用户选择。审批 UI 一次只展示并提交一个未决决策，禁止“批准全部 Gate”，所有决策完成后才 close。动态产品范围、架构 proposal 和 intentional difference 若需要裁决，必须由 Work Item 预先声明匹配的结构化决策；Harness 不得临时发明空泛 gate。发布、知识 promotion、golden 接受和 patch promotion 仍属于外部受信 authority transition，本地点击不能完成。历史已物化 Work Item/Approval 继续可读，新 candidate 若声明非空 gates 却没有 v1 decision contract，preflight 必须 fail closed。",
    "depends_on": [
      "IOS-HARNESS-APPROVAL-UI-001",
      "IOS-TRUSTED-SUPERVISOR-REFERENCE-001"
    ],
    "scope": {
      "allow_write": [
