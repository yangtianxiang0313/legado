{
  "api_version": "legado.harness/v1",
  "kind": "WorkItem",
  "metadata": {
    "id": "IOS-SOURCE-RUNTIME-GOLDEN-CONFORMANCE-001",
    "title": "让 iOS SourceRuntime 与 Android Golden 做真实结构化验收",
    "priority": 100,
    "risk": "high",
    "labels": [
      "product",
      "conformance",
      "source-runtime",
      "android-golden",
      "first-divergence",
      "false-green"
    ]
  },
  "spec": {
    "capability": "CAP-CONFORMANCE",
    "intent": "消除 conformance-targeted 只校验 FixtureTransport HTTP 摘要、未执行 SourceRuntime 的假绿。ConformanceCLI 必须从受控 SourceLab source.json 构造 HTML/CSS SourceRuntime，依次执行 search、book_info、chapters、content，输出稳定 source_pipeline portable_known_projection，并与受保护 Android Golden 的同名投影做 canonical exact comparison。差异必须以确定性的首个 JSON Pointer fail closed；404 边界用例继续由 transport lane 覆盖，不得伪装成 Android 已观测的 portable cases。不得访问真实网络、硬编码书名/正文/业务结果或修改 Golden。",
    "depends_on": [
      "IOS-SOURCE-RUNTIME-HTML-CSS-001",
      "IOS-DELIVERY-INTENT-SETTLEMENT-001"
    ],
    "scope": {
      "allow_write": [
        "ios/Packages/LegadoKit/Sources/ConformanceCLI/**",
        "ios/Packages/LegadoKit/Sources/TestSupport/FixtureModel.swift",
        "ios/Packages/LegadoKit/Sources/TestSupport/FixtureLoader.swift",
        "ios/Packages/LegadoKit/Sources/SourceRuntime/HTMLCSSSourceRuntime.swift",
        "ios/Packages/LegadoKit/Tests/ConformanceCLITests/**",
        "ios/project/capabilities/CAP-CONFORMANCE.json",
        "ios/project/checkpoints/IOS-SOURCE-RUNTIME-GOLDEN-CONFORMANCE-001.json",
        "ios/project/pitfalls/PIT-0051.json"
