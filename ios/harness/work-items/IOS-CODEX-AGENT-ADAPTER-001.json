{
  "api_version": "legado.harness/v1",
  "kind": "WorkItem",
  "metadata": {
    "id": "IOS-CODEX-AGENT-ADAPTER-001",
    "title": "接入可诊断、可续接的 Codex exec Agent adapter",
    "priority": 100,
    "risk": "high",
    "labels": [
      "phase-0",
      "control-plane",
      "automation",
      "codex",
      "agent-adapter",
      "jsonl"
    ]
  },
  "spec": {
    "capability": "CAP-KNOWLEDGE-CONTROL",
    "intent": "为本地 Loop Supervisor 建立真实 Codex CLI adapter 协议：按官方稳定 codex exec 非交互入口构造 argv，使用显式 workspace-write sandbox、never approval 和 JSONL；通过 stdin 传最小任务提示，校验 Supervisor context/work-item/repo 绑定，解析 thread/turn/item/error 事件，保存可恢复 thread ID，并向 Supervisor 返回不含 prompt、context、事件正文或凭据的结构化结果。adapter 必须在启动前诊断 executable/version/CODEX_HOME；当前本机缺失原生 Codex binary 时输出稳定 blocker。不得自动修复全局安装、读取或打印 auth.json、启用 danger-full-access、使用 deprecated full-auto、绕过 Harness Gate、修改 golden、物化 Work Item 或发布知识。",
    "depends_on": [
      "IOS-LOOP-SUPERVISOR-E2E-001",
      "IOS-PROPOSAL-COMPILER-001"
    ],
    "scope": {
      "allow_write": [
        "ios/harness/codex_agent_adapter.py",
        "ios/harness/tests/test_codex_agent_adapter.py",
        "ios/harness/README.md",
        "ios/harness/codex-agent.example.json",
        "ios/project/capabilities/CAP-KNOWLEDGE-CONTROL.json",
        "ios/project/checkpoints/IOS-CODEX-AGENT-ADAPTER-001.json",
        "ios/project/pitfalls/PIT-*.json"
      ],
      "deny_write": [
        "app/**",
        "modules/**",
        "ios/Packages/**",
        "ios/harness/harness.py",
        "ios/harness/loop_supervisor.py",
        "ios/harness/approval_ui.py",
        "ios/harness/proposal_compiler.py",
        "ios/harness/config.json",
        "ios/harness/architecture-rules.json",
        "ios/harness/dependency-policy.json",
        "ios/harness/schemas/**",
        "ios/harness/business-knowledge/**",
        "ios/harness/android-intake/**",
        "ios/harness/source-lab/**",
        "ios/harness/oracle/**",
        "ios/harness/goldens/**",
        "ios/project/android-intake/**",
        "ios/project/business-knowledge/**",
        "ios/project/requirements/**",
        "ios/project/work-item-proposals/**",
        "ios/project/approvals/**",
        "ios/project/baseline.json",
        "ios/docs/**"
      ],
      "max_files_changed": 7,
      "max_changed_lines": 2200
    },
    "inputs": {
      "context_files": [
        "ios/harness/loop_supervisor.py",
        "ios/harness/supervisor.example.json",
        "ios/harness/README.md",
        "ios/docs/trusted-supervisor.md",
        "ios/project/checkpoints/IOS-LOOP-SUPERVISOR-E2E-001.json"
      ],
      "android_source_anchors": [],
      "fixtures": []
    },
    "architecture_refs": [
      "ARCH-014",
      "ADR-0004"
    ],
    "acceptance": {
      "criteria": [
        {
          "id": "AC-1",
          "statement": "doctor 只接受显式普通文件 executable 或 PATH 解析结果，以 argv 执行 --version 并返回版本化 JSON；缺文件、symlink、不可执行、spawn ENOENT、非零退出、超时和空版本分别有稳定 reason code。诊断不修改 repo、CLI 安装、用户配置或认证文件。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-2",
          "statement": "run 必须验证 repo 是当前 Git 根、context 是普通 0600 临时 JSON、LEGADO_WORK_ITEM_ID/LEGADO_CONTEXT_PATH/argv 与 context.work_item.metadata.id 和 work_item_sha256 全部一致；任何漂移在启动 Codex 前失败，不把 context 内容复制到 argv、stdout、session state 或日志。",
          "verified_by": [
            "harness-tests",
            "scope-policy"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-3",
          "statement": "首次调用使用 codex exec --json --sandbox workspace-write --ask-for-approval never --ignore-user-config，并用 '-' 从 stdin 接收固定模板提示；禁止 --yolo、danger-full-access、--full-auto、shell 字符串、动态 model 和网络开关。子 Codex 继承 Supervisor process group，允许 Supervisor timeout 回收完整进程树。",
          "verified_by": [
            "harness-tests",
            "dependency-policy"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-4",
          "statement": "JSONL 解析器要求恰好一个 thread.started、合法 thread_id、turn.started 和最终 turn.completed；malformed JSON、unknown terminal、error、turn.failed、thread ID 漂移、缺终态、非零退出或输出上限均结构化失败。adapter 最终 stdout 只含 outcome、reason_code、thread_id、事件计数、usage 数字和摘要哈希，不含 agent message/reasoning/command/file-change 正文。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-5",
          "statement": "成功 turn 后以 create/update 原子文件保存 work_item_id、work_item_sha256、repo digest、thread_id 和 last completed event digest 到 .harness-runtime/codex-sessions；同一绑定再次调用使用 codex exec resume <thread_id>，绑定漂移或 session symlink fail closed。失败/中断不得推进 session head。",
          "verified_by": [
            "harness-tests"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-6",
          "statement": "CODEX_HOME 只能由显式绝对目录参数注入给单次 Codex 子进程；adapter 不读取、复制、hash 或输出 auth.json/API key。环境使用白名单，测试证明任意宿主 secret 不到达 fake Codex；示例配置不包含个人路径、token、model 或 danger-full-access。",
          "verified_by": [
            "harness-tests",
            "dependency-policy"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-7",
          "statement": "使用 fake Codex executable 完成首次 turn、resume、失败和输出泄漏回归；另对当前真实 /opt/homebrew/bin/codex 执行只读 doctor，Evidence/Checkpoint 如实记录可用或稳定 blocker，不以 fake 测试宣称真实 CLI 已联通。",
          "verified_by": [
            "harness-tests",
            "memory-close"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        },
        {
          "id": "AC-8",
          "statement": "README 和示例配置给出 Supervisor argv 接法、专用 CODEX_HOME、CLI 修复后的 doctor/run 步骤及本地共享权限边界；Checkpoint 保留外部隔离 runner、签名 journal、受信复验和 patch promotion 缺口。",
          "verified_by": [
            "memory-close"
          ],
          "requirement_clauses": [],
          "knowledge_claims": []
        }
      ],
      "required_checks": [
