{
  "schema_version": 1,
  "mode": "trusted-isolated",
  "attempt": {
    "ephemeral_worktree": true,
    "single_writer": true,
    "lease_seconds": 86400,
    "network_default": "deny",
    "environment": "secret-free-allowlist",
    "writable_paths_from_work_item": true,
    "process_group_limits": true
  },
  "control_state": {
    "location": "external-protected-service-or-branch",
    "agent_write_access": false,
    "signed_event_chain": true
  },
  "promotion": {
    "trusted_reverify": true,
    "signed_human_gates": true,
    "atomic_code_test_memory_commit": true,
    "automatic_golden_update": true
  },
  "local_loop_driver": {
    "command": [
      "python3",
      "ios/harness/loop_supervisor.py",
      "drive",
      "--config",
      "ios/harness/supervisor.example.json",
      "--agent",
      "local-agent",
      "--max-transitions",
      "3"
    ],
    "stop_states": [
      "doctor_red",
      "awaiting_human",
      "dependency_blocked",
      "terminal_recovery",
      "queue_empty"
    ],
    "candidate_root": "ios/project/work-item-proposals/candidates",
    "materialization": "compiled-control-plane-v1-and-bound-delivery-blueprint-v1",
    "adapter_contract": {
      "launch": "argv-only-new-session-process-group",
      "timeout_cleanup": "sigterm-bounded-wait-sigkill",
      "environment": "secret-free-allowlist",
      "output_recording": "byte-count-and-sha256-only",
      "must_finish_harness_lifecycle": true
    },
    "local_maturity": "e2e-verified-single-writer"
  },
  "auto_materialization": {
    "enabled": true,
    "policy": "compiled-control-plane-v1"
  },
  "delivery_materialization": {
    "enabled": true,
    "policy": "bound-delivery-blueprint-v1"
  },
  "migration_materialization": {
    "enabled": true,
    "policy": "source-anchored-android-migration-v1"
  },
  "characterization_materialization": {
    "enabled": true,
    "policy": "source-anchored-characterization-v1"
  },
  "oracle_materialization": {
    "enabled": true,
    "policy": "source-anchored-android-oracle-v1"
  },
  "trusted_oracle_materialization": {
    "enabled": true,
    "policy": "source-anchored-trusted-android-oracle-v1"
  },
  "synthetic_provenance": {
    "enabled": true,
    "policy": "synthetic-source-provenance-v1"
  },
  "external_execution": {
    "github_oracle": {
      "enabled": false,
      "repository": "owner/legado",
      "remote": "origin"
    },
    "github_golden": {
      "enabled": true,
      "repository": "yangtianxiang0313/legado",
      "remote": "origin"
    },
    "github_business_knowledge": {
      "enabled": true,
      "repository": "yangtianxiang0313/legado",
      "remote": "origin"
    }
  },
  "agent_invocation": {
    "argv": [
      "<replace-with-agent-runner>",
      "--work-item",
      "{work_item_id}",
      "--context",
      "{context_path}",
      "--repo",
      "{repo_root}"
    ],
    "timeout_seconds": 3600
  }
}
