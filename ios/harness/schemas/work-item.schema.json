{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legado.work-item/v1",
  "type": "object",
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": {"const": "legado.harness/v1"},
    "kind": {"const": "WorkItem"},
    "metadata": {
      "type": "object",
      "required": ["id", "title", "priority", "risk", "labels"],
      "properties": {
        "id": {"type": "string", "pattern": "^IOS-[A-Z][A-Z0-9-]*-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "risk": {"enum": ["low", "medium", "high", "critical"]},
        "labels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "spec": {
      "type": "object",
      "required": ["capability", "intent", "depends_on", "scope", "architecture_refs", "acceptance", "baseline_checks", "budget", "gates", "memory", "requirements", "source_lab", "stop_on"],
      "properties": {
        "capability": {"type": "string", "pattern": "^CAP-[A-Z0-9-]+$"},
        "intent": {"type": "string", "minLength": 1},
        "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "scope": {
          "type": "object",
          "required": ["allow_write", "deny_write", "max_files_changed", "max_changed_lines"],
          "properties": {
            "allow_write": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            "deny_write": {"type": "array", "items": {"type": "string"}},
            "max_files_changed": {"type": "integer", "minimum": 1},
            "max_changed_lines": {"type": "integer", "minimum": 1}
          }
        },
        "architecture_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "acceptance": {
          "type": "object",
          "required": ["criteria", "required_checks"],
          "properties": {
            "criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "statement", "verified_by", "requirement_clauses"],
                "properties": {
                  "id": {"type": "string", "minLength": 1},
                  "statement": {"type": "string", "minLength": 1},
                  "verified_by": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                  "requirement_clauses": {"type": "array", "items": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+#RC-[0-9]{2}$"}, "uniqueItems": true}
                }
              }
            },
            "required_checks": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
          }
        },
        "baseline_checks": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "budget": {"type": "object"},
        "gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "completion_effects": {"type": "object"},
        "memory": {"type": "object"},
        "requirements": {
          "type": "object",
          "required": ["mode", "refs", "none_reason"],
          "properties": {
            "mode": {"enum": ["implementation", "enabler", "characterization", "verification", "control_plane"]},
            "refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "required": ["id", "revision", "clauses"],
                "properties": {
                  "id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"},
                  "revision": {"type": "integer", "minimum": 1},
                  "clauses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^RC-[0-9]{2}$"}}
                }
              }
            },
            "none_reason": {"type": ["string", "null"]}
          }
        },
        "source_lab": {
          "type": "object",
          "required": ["mode", "behaviors", "scenarios", "none_reason"],
          "properties": {
            "mode": {"enum": ["not_applicable", "reuse", "extend"]},
            "behaviors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "scenarios": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "none_reason": {"type": ["string", "null"]}
          }
        },
        "stop_on": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    }
  }
}
