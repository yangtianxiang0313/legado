{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legado.checkpoint/v1",
  "type": "object",
  "required": ["schema_version", "work_item_id", "summary", "evidence", "capability_updates", "architecture_impact", "requirements", "source_lab", "compatibility", "pitfalls", "remaining_risks", "next_actions", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "work_item_id": {"type": "string"},
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "string"},
    "capability_updates": {"type": "array", "minItems": 1},
    "architecture_impact": {
      "type": "object",
      "required": ["kind", "adr_refs"],
      "properties": {
        "kind": {"enum": ["none", "implements_existing", "changes_architecture"]},
        "adr_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "requirements": {
      "type": "object",
      "required": ["mode", "refs", "selection_sha256"],
      "properties": {
        "mode": {"enum": ["implementation", "enabler", "characterization", "verification", "control_plane"]},
        "refs": {"type": "array"},
        "selection_sha256": {"type": ["string", "null"]}
      }
    },
    "source_lab": {
      "type": "object",
      "required": ["mode", "behaviors", "scenarios", "selection_sha256"],
      "properties": {
        "mode": {"enum": ["not_applicable", "reuse", "extend"]},
        "behaviors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "scenarios": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "selection_sha256": {"type": ["string", "null"]}
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["records", "none_reason"],
      "properties": {"records": {"type": "array"}, "none_reason": {"type": ["string", "null"]}}
    },
    "pitfalls": {
      "type": "object",
      "required": ["records", "none_reason"],
      "properties": {"records": {"type": "array"}, "none_reason": {"type": ["string", "null"]}}
    },
    "remaining_risks": {"type": "array"},
    "next_actions": {"type": "array", "maxItems": 5},
    "created_at": {"type": "string"}
  }
}
