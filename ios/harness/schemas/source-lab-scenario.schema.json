{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legado.source-lab-scenario/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "revision", "status", "operation", "capabilities", "compatibility_profile", "source", "input", "transport", "coverage", "determinism", "limits", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"enum": ["source_lab_scenario", "android_runtime_scenario"]},
    "id": {"type": "string", "pattern": "^(sl|rl)-[a-z0-9-]+-[0-9]{3}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["candidate", "reference", "retired"]},
    "operation": {"enum": ["source_lab_site", "android_runtime"]},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "compatibility_profile": {"type": "string", "minLength": 1},
    "source": {"type": ["string", "null"], "minLength": 1},
    "input": {"type": "string", "minLength": 1},
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "external_network", "responses"],
      "properties": {
        "mode": {"enum": ["fixture_and_loopback", "none"]},
        "external_network": {"const": "deny"},
        "responses": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "match", "respond"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "match": {
                "type": "object",
                "additionalProperties": false,
                "required": ["method", "path", "query"],
                "properties": {
                  "method": {"enum": ["GET", "POST"]},
                  "path": {"type": "string", "pattern": "^/"},
                  "query": {"type": "object"}
                }
              },
              "respond": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "headers", "body_file"],
                "properties": {
                  "status": {"type": "integer", "minimum": 100, "maximum": 599},
                  "headers": {"type": "object"},
                  "body_file": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["behavior", "cases"],
        "properties": {
          "behavior": {"type": "string", "minLength": 1},
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "role", "android_fact_refs", "branch_refs"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "role": {"enum": ["nominal", "boundary", "malformed", "denied"]},
                "android_fact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^AF-[A-Z0-9-]+$"}},
                "branch_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock", "timezone", "locale", "random_seed", "network_allowed", "logical_origin"],
      "properties": {
        "clock": {"type": "string"},
        "timezone": {"const": "UTC"},
        "locale": {"const": "en_US_POSIX"},
        "random_seed": {"type": "integer"},
        "network_allowed": {"const": false},
        "logical_origin": {"enum": ["http://sourcelab.test", null]},
        "database_reset_per_case": {"type": "boolean"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_ms", "max_response_bytes", "max_request_body_bytes", "max_requests", "max_concurrency"],
      "properties": {
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 5000},
        "max_response_bytes": {"type": "integer", "minimum": 1, "maximum": 10485760},
        "max_request_body_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "max_requests": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_refs", "introduced_by"],
      "properties": {
        "kind": {"enum": ["synthetic", "sanitized_capture"]},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "introduced_by": {"type": "string", "minLength": 1}
      }
    }
  }
}
