{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legado.integration-lab-scenario/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "revision",
    "status",
    "operation",
    "capabilities",
    "compatibility_profile",
    "input",
    "transport",
    "coverage",
    "determinism",
    "limits",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "integration_lab_scenario"},
    "id": {"type": "string", "pattern": "^il-[a-z0-9-]+-[0-9]{3}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["candidate", "reference", "retired"]},
    "operation": {"const": "webdav_protocol"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "compatibility_profile": {"type": "string", "minLength": 1},
    "input": {"type": "string", "minLength": 1},
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "external_network", "responses"],
      "properties": {
        "mode": {"const": "fixture_and_loopback"},
        "external_network": {"const": "deny"},
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "match", "respond"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "match": {
                "type": "object",
                "additionalProperties": false,
                "required": ["method", "path"],
                "properties": {
                  "method": {
                    "enum": ["GET", "PUT", "DELETE", "PROPFIND", "MKCOL"]
                  },
                  "path": {"type": "string", "pattern": "^/"}
                }
              },
              "respond": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "headers", "body_file"],
                "properties": {
                  "status": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  "headers": {"type": "object"},
                  "body_file": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "coverage": {"type": "array", "minItems": 1},
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "timezone",
        "locale",
        "random_seed",
        "network_allowed",
        "logical_origin"
      ],
      "properties": {
        "clock": {"type": "string"},
        "timezone": {"const": "UTC"},
        "locale": {"const": "en_US_POSIX"},
        "random_seed": {"type": "integer"},
        "network_allowed": {"const": false},
        "logical_origin": {"const": "http://integrationlab.test"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeout_ms",
        "max_response_bytes",
        "max_request_body_bytes",
        "max_requests",
        "max_concurrency"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_refs", "introduced_by"]
    }
  }
}
