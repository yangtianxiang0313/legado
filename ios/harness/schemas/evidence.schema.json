{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legado.evidence/v1",
  "type": "object",
  "required": ["schema_version", "run_id", "work_item_id", "work_item_sha256", "result", "inputs", "changes", "policy_errors", "architecture_errors", "checks", "started_at", "finished_at"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "work_item_id": {"type": "string"},
    "work_item_sha256": {"type": "string"},
    "result": {"enum": ["passed", "failed", "blocked"]},
    "inputs": {"type": "object"},
    "changes": {"type": "object"},
    "policy_errors": {"type": "array", "items": {"type": "string"}},
    "architecture_errors": {"type": "array", "items": {"type": "string"}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "definition_sha256", "passed", "exit_code", "timed_out", "process_leak"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "definition_sha256": {"type": "string", "minLength": 64},
          "passed": {"type": "boolean"},
          "exit_code": {"type": ["integer", "null"]},
          "timed_out": {"type": "boolean"},
          "process_leak": {"type": "boolean"}
        }
      }
    },
    "failure": {"type": ["object", "null"]},
    "started_at": {"type": "string"},
    "finished_at": {"type": "string"}
  }
}
