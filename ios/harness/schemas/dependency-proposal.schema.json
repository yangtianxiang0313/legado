{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legado.dependency-proposal/v1",
  "type": "object",
  "required": ["schema_version", "id", "identity", "from_version", "to_exact_version", "products", "allowed_targets", "expected_revision", "adr", "reason", "alternatives", "transitive_dependencies", "license", "privacy_manifest", "security_review", "size_delta_bytes", "exit_plan", "owner", "required_checks", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^DEP-[0-9]{4}$"},
    "identity": {"type": "string", "minLength": 1},
    "from_version": {"type": ["string", "null"]},
    "to_exact_version": {"type": "string", "minLength": 1},
    "products": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "allowed_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "expected_revision": {"type": "string", "minLength": 40},
    "adr": {"type": "string", "pattern": "^ADR-[0-9]{4}$"},
    "reason": {"type": "string", "minLength": 1},
    "alternatives": {"type": "array", "minItems": 1},
    "transitive_dependencies": {"type": "array"},
    "license": {"type": "string", "minLength": 1},
    "privacy_manifest": {"type": "string", "minLength": 1},
    "security_review": {"type": "string", "minLength": 1},
    "size_delta_bytes": {"type": "integer"},
    "exit_plan": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "required_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "status": {"enum": ["proposed", "approved", "rejected", "applied"]}
  }
}
