{
  "schema_version": 1,
  "agent_invocation": {
    "argv": [
      "python3",
      "ios/harness/codex_agent_adapter.py",
      "run",
      "--codex",
      "<absolute-path-to-codex>",
      "--codex-home",
      "<absolute-dedicated-codex-home>",
      "--repo",
      "{repo_root}",
      "--context",
      "{context_path}",
      "--work-item",
      "{work_item_id}"
    ],
    "timeout_seconds": 7200
  }
}
