{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legado.knowledge-revision-tombstone/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "knowledge_kind",
    "id",
    "revision",
    "status",
    "producer_work_item",
    "producer_terminal_status",
    "reason_code",
    "evidence",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "KnowledgeRevisionTombstone"},
    "knowledge_kind": {"enum": ["packet", "driver"]},
    "id": {
      "type": "string",
      "pattern": "^(BKP|DRV)-[A-Z][A-Z0-9-]*-[0-9]{3}$"
    },
    "revision": {"type": "integer", "minimum": 1},
    "status": {"const": "abandoned"},
    "producer_work_item": {
      "type": "string",
      "pattern": "^IOS-[A-Z][A-Z0-9-]*-[0-9]{3}$"
    },
    "producer_terminal_status": {
      "enum": ["blocked", "rejected", "exhausted", "cancelled"]
    },
    "reason_code": {"type": "string", "minLength": 1},
    "evidence": {
      "type": ["string", "null"]
    },
    "created_by": {
      "type": "string",
      "pattern": "^IOS-[A-Z][A-Z0-9-]*-[0-9]{3}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
