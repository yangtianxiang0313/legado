{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legado.architecture-driver/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "revision",
    "status",
    "semantic_key",
    "title",
    "claim_refs",
    "forces",
    "decision_questions",
    "resolution",
    "promotion",
    "supersedes",
    "created_by"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "ArchitectureDriver"},
    "id": {"type": "string", "pattern": "^DRV-[A-Z][A-Z0-9-]*-[0-9]{3}$"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["proposed", "active", "resolved"]},
    "semantic_key": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
    "title": {"type": "string", "minLength": 1},
    "claim_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision"],
        "properties": {
          "id": {"type": "string", "pattern": "^BKC-[A-Z][A-Z0-9-]*-[0-9]{3}$"},
          "revision": {"type": "integer", "minimum": 1}
        }
      }
    },
    "forces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quality_attribute", "scenario", "criticality"],
        "properties": {
          "quality_attribute": {"type": "string", "minLength": 1},
          "scenario": {"type": "string", "minLength": 1},
          "criticality": {"enum": ["low", "medium", "high", "critical"]}
        }
      }
    },
    "decision_questions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "adr_refs", "work_item_refs"],
      "properties": {
        "state": {
          "enum": [
            "open",
            "requires_characterization",
            "requires_spike",
            "requires_adr",
            "resolved",
            "accepted_risk"
          ]
        },
        "adr_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^ADR-[0-9]{4}$"}
        },
        "work_item_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^IOS-[A-Z][A-Z0-9-]*-[0-9]{3}$"}
        }
      }
    },
    "promotion": {
      "type": ["object", "null"],
      "properties": {
        "approval_ref": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1}
      }
    },
    "supersedes": {
      "type": ["object", "null"],
      "properties": {
        "id": {"type": "string", "pattern": "^DRV-[A-Z][A-Z0-9-]*-[0-9]{3}$"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "created_by": {"type": "string", "pattern": "^IOS-[A-Z][A-Z0-9-]*-[0-9]{3}$"}
  }
}
